<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>C++/Rust/Python Roadmap 2026-2030</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap');
        
        :root {
            --primary: #003f5c;
            --secondary: #7a5195;
            --accent-pink: #ef5675;
            --accent-orange: #ffa600;
            --bg-light: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-light);
            color: #1e293b;
        }

        .chart-container {
            position: relative;
            width: 100%;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
            height: 350px;
            max-height: 400px;
        }

        @media (max-width: 768px) {
            .chart-container {
                height: 300px;
            }
        }

        .timeline-line {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            width: 4px;
            height: 100%;
            background: linear-gradient(to bottom, var(--primary), var(--secondary), var(--accent-pink));
        }

        .card-hover:hover {
            transform: translateY(-5px);
            transition: transform 0.3s ease;
        }

        .step-node {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: white;
            border: 4px solid var(--accent-pink);
            z-index: 10;
        }
    </style>
</head>
<body class="overflow-x-hidden">

    <!-- 
    PALETTE CHOSEN: "Brilliant & Professional" (Deep Blue, Purple, Pink, Orange)
    
    PLAN NARRATIVE:
    1. Hero: The Goal (₹12-25 LPA target).
    2. Data Overview: Salary growth projection (Line Chart).
    3. Language Strategy: Distribution of focus over 5 years (Donut Chart).
    4. Skill Evolution: Competency map from Year 1 to Year 5 (Radar Chart).
    5. The Journey: Vertical timeline of specific yearly milestones and project focuses.
    6. Market Alignment: High-impact sectors (HFT, AI, Cloud).

    VISUALIZATION CHOICES:
    - Salary Projection -> Goal: Change -> Line Chart (Chart.js) -> Best for visualizing temporal trends.
    - Language Focus -> Goal: Composition -> Donut Chart (Chart.js) -> Shows proportions of effort.
    - Skill Radar -> Goal: Relationships -> Radar Chart (Chart.js) -> Compares proficiency levels across categories.
    - HFT/AI Pillars -> Goal: Organize -> Card Layout (Tailwind) -> Highlights key sectors.
    
    CONFIRMATION: NO SVG, NO MERMAID JS USED. Diagrams built with CSS/HTML.
    -->

    <header class="bg-[#003f5c] text-white py-16 px-6 text-center">
        <h1 class="text-4xl md:text-6xl font-extrabold mb-4">Engineering Career Roadmap</h1>
        <p class="text-xl md:text-2xl text-blue-200 max-w-3xl mx-auto">
            Strategic mastery of C++, Rust, and Python to secure high-performance product roles (₹12–25 LPA) by 2030.
        </p>
        <div class="mt-8 flex justify-center gap-8">
            <div class="text-center">
                <span class="block text-3xl font-bold text-[#ffa600]">₹12 LPA+</span>
                <span class="text-sm uppercase tracking-widest text-blue-100">Base Target</span>
            </div>
            <div class="border-l border-blue-400 h-12"></div>
            <div class="text-center">
                <span class="block text-3xl font-bold text-[#ef5675]">5 Years</span>
                <span class="text-sm uppercase tracking-widest text-blue-100">Strategic Prep</span>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-12">
        
        <section class="mb-20">
            <div class="text-center mb-10">
                <h2 class="text-3xl font-bold text-[#003f5c] mb-2">Financial Growth & Market Projection</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">This chart forecasts your potential earning trajectory based on successful execution of the milestone projects and internship targets.</p>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
                <div class="lg:col-span-2 bg-white p-6 rounded-2xl shadow-xl">
                    <div class="chart-container" style="height: 400px; max-height: 450px;">
                        <canvas id="salaryChart"></canvas>
                    </div>
                </div>
                <div class="space-y-6">
                    <div class="bg-[#7a5195] text-white p-6 rounded-xl shadow-lg">
                        <h3 class="text-xl font-bold mb-2">2030 Milestone</h3>
                        <p class="text-sm opacity-90">Upon completion, your profile targets High-Frequency Trading (HFT) and AI Engineering roles, which traditionally command the highest entry-level packages in India.</p>
                    </div>
                    <div class="bg-[#ffa600] text-white p-6 rounded-xl shadow-lg">
                        <h3 class="text-xl font-bold mb-2">Internship Impact</h3>
                        <p class="text-sm opacity-90">Targeting ₹30k-60k/month internships in 2028-29 acts as a catalyst for the final ₹1.5L+/month full-time placement.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-20 grid grid-cols-1 md:grid-cols-2 gap-12">
            <div class="bg-white p-8 rounded-2xl shadow-xl">
                <h2 class="text-2xl font-bold text-[#003f5c] mb-6 text-center">Language Portfolio Focus</h2>
                <p class="text-sm text-gray-600 mb-8 text-center">Relative time allocation across the three core languages by the time you reach graduation in 2030.</p>
                <div class="chart-container">
                    <canvas id="languageDonut"></canvas>
                </div>
            </div>
            <div class="bg-white p-8 rounded-2xl shadow-xl">
                <h2 class="text-2xl font-bold text-[#003f5c] mb-6 text-center">Competency Evolution</h2>
                <p class="text-sm text-gray-600 mb-8 text-center">Comparing your starting profile (Current) vs. the target profile (2030) across key technical domains.</p>
                <div class="chart-container">
                    <canvas id="skillRadar"></canvas>
                </div>
            </div>
        </section>

        <section class="mb-20">
            <div class="text-center mb-16">
                <h2 class="text-3xl font-bold text-[#003f5c]">The 5-Year Journey</h2>
                <p class="text-gray-600">A detailed breakdown of focus areas, projects, and goals for each academic year.</p>
            </div>

            <div class="relative">
                <div class="hidden md:block timeline-line"></div>

                <div class="relative flex flex-col md:flex-row items-center mb-16 md:justify-between group">
                    <div class="w-full md:w-[45%] bg-white p-6 rounded-xl shadow-md border-l-4 border-[#003f5c] card-hover">
                        <span class="text-[#003f5c] font-bold text-sm uppercase">Year 1: 2026</span>
                        <h3 class="text-xl font-bold mt-1">Foundations & DSA</h3>
                        <p class="text-gray-600 mt-2 text-sm">Mastering C++ STL and Python OOP. Building automation scripts and core algorithm libraries.</p>
                        <div class="mt-4 flex flex-wrap gap-2">
                            <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded">C++ Syntax</span>
                            <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded">Python Basics</span>
                        </div>
                    </div>
                    <div class="hidden md:block step-node"></div>
                    <div class="hidden md:block w-[45%]"></div>
                </div>

                <div class="relative flex flex-col md:flex-row-reverse items-center mb-16 md:justify-between group">
                    <div class="w-full md:w-[45%] bg-white p-6 rounded-xl shadow-md border-r-4 border-[#7a5195] text-right card-hover">
                        <span class="text-[#7a5195] font-bold text-sm uppercase">Year 2: 2027</span>
                        <h3 class="text-xl font-bold mt-1">Systems & Frontend</h3>
                        <p class="text-gray-600 mt-2 text-sm text-right">Deep dive into C++ Memory Management. Building a personal developer portfolio and file system simulators.</p>
                        <div class="mt-4 flex flex-wrap gap-2 justify-end">
                            <span class="px-2 py-1 bg-purple-100 text-purple-800 text-xs rounded">TypeScript</span>
                            <span class="px-2 py-1 bg-purple-100 text-purple-800 text-xs rounded">Pointers</span>
                        </div>
                    </div>
                    <div class="hidden md:block step-node" style="border-color: #7a5195;"></div>
                    <div class="hidden md:block w-[45%]"></div>
                </div>

                <div class="relative flex flex-col md:flex-row items-center mb-16 md:justify-between group">
                    <div class="w-full md:w-[45%] bg-white p-6 rounded-xl shadow-md border-l-4 border-[#ef5675] card-hover">
                        <span class="text-[#ef5675] font-bold text-sm uppercase">Year 3: 2028</span>
                        <h3 class="text-xl font-bold mt-1">The Rust Transition</h3>
                        <p class="text-gray-600 mt-2 text-sm">Learning Rust Memory Safety (Ownership/Borrowing). Starting AI/ML tracks with Python PyTorch/TensorFlow.</p>
                        <div class="mt-4 flex flex-wrap gap-2">
                            <span class="px-2 py-1 bg-pink-100 text-pink-800 text-xs rounded">Rustlings</span>
                            <span class="px-2 py-1 bg-pink-100 text-pink-800 text-xs rounded">Neural Networks</span>
                        </div>
                    </div>
                    <div class="hidden md:block step-node"></div>
                    <div class="hidden md:block w-[45%]"></div>
                </div>

                <div class="relative flex flex-col md:flex-row-reverse items-center mb-16 md:justify-between group">
                    <div class="w-full md:w-[45%] bg-white p-6 rounded-xl shadow-md border-r-4 border-[#ffa600] text-right card-hover">
                        <span class="text-[#ffa600] font-bold text-sm uppercase">Year 4: 2029</span>
                        <h3 class="text-xl font-bold mt-1">Scale & Concurrency</h3>
                        <p class="text-gray-600 mt-2 text-sm">High-performance Rust microservices (Tokio/Actix) and C++ Trading Engines. Intensive Placement Prep.</p>
                        <div class="mt-4 flex flex-wrap gap-2 justify-end">
                            <span class="px-2 py-1 bg-orange-100 text-orange-800 text-xs rounded">Async Rust</span>
                            <span class="px-2 py-1 bg-orange-100 text-orange-800 text-xs rounded">System Design</span>
                        </div>
                    </div>
                    <div class="hidden md:block step-node" style="border-color: #ffa600;"></div>
                    <div class="hidden md:block w-[45%]"></div>
                </div>
            </div>
        </section>

        <section class="mb-12 bg-[#1e293b] text-white rounded-3xl p-8 md:p-12 overflow-hidden relative">
            <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                <div>
                    <h2 class="text-3xl font-bold mb-4">India-Specific Success Strategy</h2>
                    <ul class="space-y-4">
                        <li class="flex items-start gap-3">
                            <div class="mt-1 w-5 h-5 bg-[#ef5675] rounded flex-shrink-0 flex items-center justify-center font-bold text-xs">1</div>
                            <p class="text-slate-300"><span class="text-white font-bold">HFT Target:</span> Focus on cache-friendly C++ and Valgrind profiling. Companies like Graviton pay ₹30-60LPA for these skills.</p>
                        </li>
                        <li class="flex items-start gap-3">
                            <div class="mt-1 w-5 h-5 bg-[#ffa600] rounded flex-shrink-0 flex items-center justify-center font-bold text-xs">2</div>
                            <p class="text-slate-300"><span class="text-white font-bold">Open Source:</span> A single PR to the Rust compiler or a major C++ lib places you in the top 1% of applicants globally.</p>
                        </li>
                        <li class="flex items-start gap-3">
                            <div class="mt-1 w-5 h-5 bg-[#7a5195] rounded flex-shrink-0 flex items-center justify-center font-bold text-xs">3</div>
                            <p class="text-slate-300"><span class="text-white font-bold">CS Fundamentals:</span> Coding is 40%, but OS, Threading, and Databases are 60% of the interview for senior product roles.</p>
                        </li>
                    </ul>
                </div>
                <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700">
                    <h4 class="text-center font-bold mb-4 text-[#ffa600]">Salary Breakdown (Est.)</h4>
                    <div id="salaryBreakdownPlot" class="w-full h-64"></div>
                </div>
            </div>
        </section>

    </main>

    <footer class="bg-slate-100 py-8 border-t border-slate-200">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-slate-500 text-sm">Targeting Excellence: 2026 — 2030 Career Roadmap</p>
            <p class="text-slate-400 text-xs mt-2 italic">Data based on current Indian market trends for Tier-1 Product Companies.</p>
        </div>
    </footer>

    <script>
        const wrapLabels = (labels) => {
            return labels.map(label => {
                if (label.length > 16) {
                    const words = label.split(' ');
                    let lines = [];
                    let currentLine = '';
                    words.forEach(word => {
                        if ((currentLine + word).length > 16) {
                            lines.push(currentLine.trim());
                            currentLine = word + ' ';
                        } else {
                            currentLine += word + ' ';
                        }
                    });
                    lines.push(currentLine.trim());
                    return lines;
                }
                return label;
            });
        };

        const tooltipConfig = {
            callbacks: {
                title: function(tooltipItems) {
                    const item = tooltipItems[0];
                    let label = item.chart.data.labels[item.dataIndex];
                    if (Array.isArray(label)) {
                        return label.join(' ');
                    } else {
                        return label;
                    }
                }
            }
        };

        const ctxSalary = document.getElementById('salaryChart').getContext('2d');
        new Chart(ctxSalary, {
            type: 'line',
            data: {
                labels: ['2026', '2027', '2028 (Intern)', '2029 (Placement)', '2030 (Graduation)'],
                datasets: [{
                    label: 'Target Salary (Lakhs Per Annum)',
                    data: [0, 0.5, 6.0, 15.0, 22.0],
                    borderColor: '#ef5675',
                    backgroundColor: 'rgba(239, 86, 117, 0.1)',
                    fill: true,
                    tension: 0.4,
                    borderWidth: 4,
                    pointRadius: 6,
                    pointBackgroundColor: '#ffa600'
                }]
            },
            options: {
                maintainAspectRatio: false,
                responsive: true,
                plugins: {
                    legend: { position: 'top' },
                    tooltip: tooltipConfig
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: '₹ LPA' }
                    }
                }
            }
        });

        const ctxDonut = document.getElementById('languageDonut').getContext('2d');
        new Chart(ctxDonut, {
            type: 'doughnut',
            data: {
                labels: ['C++ (Systems/DSA)', 'Rust (Future-Proof)', 'Python (AI/ML)', ['Web', 'Development']],
                datasets: [{
                    data: [40, 30, 20, 10],
                    backgroundColor: ['#003f5c', '#7a5195', '#ef5675', '#ffa600'],
                    borderWidth: 0
                }]
            },
            options: {
                maintainAspectRatio: false,
                responsive: true,
                plugins: {
                    legend: { position: 'bottom' },
                    tooltip: tooltipConfig
                }
            }
        });

        const ctxRadar = document.getElementById('skillRadar').getContext('2d');
        new Chart(ctxRadar, {
            type: 'radar',
            data: {
                labels: wrapLabels(['Systems Programming', 'Data Structures', 'AI/ML Engineering', 'Backend Scaling', 'Frontend Web']),
                datasets: [{
                    label: 'Current (2026)',
                    data: [20, 35, 10, 5, 40],
                    borderColor: '#ffa600',
                    backgroundColor: 'rgba(255, 166, 0, 0.2)',
                }, {
                    label: 'Goal (2030)',
                    data: [95, 90, 80, 85, 70],
                    borderColor: '#003f5c',
                    backgroundColor: 'rgba(0, 63, 92, 0.2)',
                }]
            },
            options: {
                maintainAspectRatio: false,
                responsive: true,
                plugins: {
                    tooltip: tooltipConfig
                },
                scales: {
                    r: {
                        angleLines: { display: true },
                        suggestedMin: 0,
                        suggestedMax: 100
                    }
                }
            }
        });

        const salaryData = [{
            x: ['Base Pay', 'Joining Bonus', 'Performance', 'RSUs/ESOPs'],
            y: [14, 3, 2, 6],
            type: 'bar',
            marker: {
                color: ['#003f5c', '#7a5195', '#ef5675', '#ffa600']
            }
        }];

        const layout = {
            paper_bgcolor: 'rgba(0,0,0,0)',
            plot_bgcolor: 'rgba(0,0,0,0)',
            font: { color: '#cbd5e1', size: 10 },
            margin: { t: 20, r: 20, b: 40, l: 30 },
            showlegend: false,
            yaxis: { gridcolor: '#334155' }
        };

        Plotly.newPlot('salaryBreakdownPlot', salaryData, layout, { staticPlot: true, responsive: true });

    </script>
</body>
</html>
