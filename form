<!DOCTYPE html>
<html>
    
    <head>
        <title>  form</title>
    </head>
    <body>
        <form action="index.php" method="post" enctype="multipart/form-data">
            <label for="username">username:</label>
            <input type="text" id="username" required minlength="3" placeholder="bankai" maxlength="255">
            <br>

            <label for="password">password:</label>
            <input type="password" id="password" required minlength="8" maxlength="25">
            <br>

            <label for="email">email:</label>
            <input type="email" id="email" required placeholder="abc@gmail.com" minlength="13" maxlength="255">
            <br>

            <label for="phone">phone number:</label>
            <input type="phone" id="phone" required pattern="[6-9]{1}[0-9]{9}" minlength="10" maxlength="10">
            <br>

            <label for="birthdate">birthdate:</label>
            <input type="date" id="birthdate" required placeholder="DD-MM-YYYY" pattern="[0-3]{2}-[0-1]{2}-[1-2]{1}[0-9]{3}" >
            <br>

            <label for="quantity">quantity:</label>
            <input type="number" id="quantity" required min="0" max="100" value="1">
            <br>

            <label for="title">title:</label>

            <label for="Mr.">Mr.</label>
            <input type="radio" id="Mr." value="Mr." name="title">
            <label for="Mrs.">Mrs.</label>
            <input type="radio" id="Mrs." value="Mrs." name="title">
            <label for="Dr.">Dr.</label>
            <input type="radio" id="Dr." value="Dr." name="title">
            <br>

            <label for="pay">method for payment:</label>
            <select>
                <option value="visa">visa</option>
                <option value="master card">master card</option>
                <option value="credit card">credit card</option>
                
            </select>
            <br>

            <label for="subscribe">subscribe</label>
            <input type="checkbox" id="subscribe"><br>

            <label for="comment">comment:</label>
            <textarea id="comment" rows="4" cols="45"></textarea>
            <br>

            <label for="file">file:</label>
            <input id="file" type="file" accept="image/png">
            <hr>
            <input type="reset"><br><input type="submit">
        </form>
    </body>
</html>
